# Multi-stage Dockerfile for AICK-MMP modular build

# Stage 1: Build all modules with Maven reactor
FROM maven:3.6.3-openjdk-8-slim AS builder
WORKDIR /build

# Copy only the necessary files for dependency resolution first (better layer caching)
COPY backend/pom.xml backend/
COPY backend/aick-mmp-parent ./backend/aick-mmp-parent
COPY backend/aick-mmp-shared ./backend/aick-mmp-shared
COPY backend/aick-mmp-central ./backend/aick-mmp-central
COPY backend/aick-mmp-edge ./backend/aick-mmp-edge

# Build all modules with a single Maven command
RUN cd backend && mvn clean package -DskipTests

# Stage 2: Central runtime
FROM openjdk:8-jre-slim AS central-runtime
WORKDIR /app
RUN groupadd -r aick && useradd --no-log-init -r -g aick aick
COPY --from=builder /build/backend/aick-mmp-central/target/aick-mmp-central-*.jar app.jar
RUN chown -R aick:aick /app
USER aick
EXPOSE 8080
ENV JAVA_OPTS="-Xmx1g -Xms1g -XX:+UseG1GC -XX:+UseStringDeduplication"
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]

# Stage 3: Edge runtime
FROM openjdk:8-jre-slim AS edge-runtime
WORKDIR /app
RUN groupadd -r aick && useradd --no-log-init -r -g aick aick
COPY --from=builder /build/backend/aick-mmp-edge/target/aick-mmp-edge-*.jar app.jar
RUN chown -R aick:aick /app
USER aick
EXPOSE 8080
ENV JAVA_OPTS="-Xmx1g -Xms1g -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m"
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]

# Default to edge runtime
FROM edge-runtime